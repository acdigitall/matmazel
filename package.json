{
  "name": "matmazel",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MATMAZEL İzmit - PHP web sitesi. Node yalnızca Tailwind CSS derlemesi için gerekir.",
  "scripts": {
    "css": "tailwindcss --postcss -i ./resources/tailwind.css -o ./assets/css/style.css --minify",
    "css:watch": "tailwindcss --postcss -i ./resources/tailwind.css -o ./assets/css/style.css --watch",
    "serve": "php -S localhost:8000 router.php"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  },
  "browserslist": [
    "> 0.3%",
    "last 2 versions",
    "iOS >= 14",
    "Safari >= 14",
    "not dead"
  ]
}
